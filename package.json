{
  "name": "steckplan-monorepo",
  "version": "0.20.0",
  "private": true,
  "description": "Steckplan – Planung von Licht-, Ton- und Netzwerktechnik für Veranstaltungen",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rde-master/steckplan.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @steckplan/desktop dist",
    "dev": "pnpm --parallel --filter @steckplan/server --filter @steckplan/ui dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "version:sync": "node scripts/sync-version.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "docker:build": "docker build -f apps/docker/Dockerfile -t steckplan:dev .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
