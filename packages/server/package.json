{
  "name": "@steckplan/server",
  "version": "0.23.0",
  "private": true,
  "description": "Steckplan-Server (Fastify) – eingebettet in der Desktop-App oder eigenständig im Docker-Container",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "cross-env STECKPLAN_EDIT_PASSWORD=dev-bearbeiten STECKPLAN_READ_PASSWORD=dev-lesen STECKPLAN_DATA_DIR=../../.dev-data tsx watch src/standalone.ts",
    "build": "tsup",
    "start": "node dist/standalone.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "@steckplan/core": "workspace:*",
    "fastify": "^5.12.7",
    "fflate": "0.8.3",
    "lib0": "^0.2.119",
    "qrcode": "^1.5.4",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  }
}
