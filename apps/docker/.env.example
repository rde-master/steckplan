# Vorlage für die Einstellungen – nach .env kopieren und anpassen.
# Die Datei .env enthält Passwörter: nicht weitergeben, nicht ins Git einchecken.

# Pflicht: zwei verschiedene Passwörter
# Bearbeiten: alles bearbeiten, Projekte anlegen/löschen, Bibliothek pflegen
STECKPLAN_EDIT_PASSWORD=bitte-aendern-bearbeiten
# Lesen: ansehen, herunterladen, Packliste abhaken
STECKPLAN_READ_PASSWORD=bitte-aendern-lesen

# Optional
# Version des Images (Standard: latest), z. B. 0.14.1
#STECKPLAN_VERSION=latest
# Port auf dem Server (nur docker-compose.yml, Standard 8080)
#STECKPLAN_PORT=8080
# Zeitzone
TZ=Europe/Berlin

# Nur für docker-compose.https.yml: Domain, die auf diesen Server zeigt (DNS-Eintrag nötig)
#STECKPLAN_DOMAIN=steckplan.example.de
